              "raw": "{{baseUrl}}/api/v1/predictions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "predictions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"league\": \"E0\",\n  \"home_team\": \"Arsenal\",\n  \"away_team\": \"Chelsea\",\n  \"match_date\": \"{{date}}\",\n  \"odds\": {\n    \"home\": 1.98,\n    \"draw\": 3.9,\n    \"away\": 4.5\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST predicción sin cuotas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
