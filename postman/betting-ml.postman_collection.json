    {
      "name": "Partidos del día",
      "item": [
        {
          "name": "GET partidos de hoy (Lima)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"count coincide\", function () { const b = pm.response.json(); pm.expect(b.count).to.eql(b.matches.length); });",
                  "pm.test(\"probabilidades suman ~1\", function () { const body = pm.response.json(); const items = body.matches ? body.matches : [body]; items.forEach(function (m) { const p = m.probabilities; pm.expect(p.home + p.draw + p.away).to.be.closeTo(1, 0.001); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matches"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "GET partidos de una fecha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"probabilidades suman ~1\", function () { const body = pm.response.json(); const items = body.matches ? body.matches : [body]; items.forEach(function (m) { const p = m.probabilities; pm.expect(p.home + p.draw + p.away).to.be.closeTo(1, 0.001); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches?date={{date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matches"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "GET solo value bets de E0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"todas con value bet\", function () { pm.response.json().matches.forEach(function (m) { pm.expect(m.value_bets.length).to.be.above(0); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches?date={{date}}&league=E0&only_value=true&min_edge=0.05",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matches"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "league",
                  "value": "E0"
                },
                {
                  "key": "only_value",
                  "value": "true"
                },
                {
                  "key": "min_edge",
                  "value": "0.05"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "GET fecha sin partidos (lista vacía)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"lista vacía con mensaje\", function () { const b = pm.response.json(); pm.expect(b.count).to.eql(0); pm.expect(b.message).to.be.a(\"string\"); });"
                ]
