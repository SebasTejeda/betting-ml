TIMEZONE=America/Lima
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports
FIXTURES_CACHE_HOURS=6
SCRAPE_DELAY_SECONDS=3
SEED=42
# --- spec 002
ODDS_API_KEY=
ODDS_API_REGIONS=eu,uk
ODDS_MIN_CREDITS_RESERVE=50
ODDS_AUTO_REFRESH=false
ODDS_AUTO_REFRESH_TIMES=10:00,16:00
EXCHANGE_COMMISSION=0.05
DATABASE_URL=sqlite:///data/app.db

# --- spec 003: seguridad
# dev: localhost, /docs visibles, cookies sin Secure. prod: la API no arranca si algo de abajo es inseguro.
APP_ENV=dev
# Clave de máquina (Postman, CLI, scripts). En prod: >= 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Con el valor de ejemplo las escrituras quedan deshabilitadas (503).
APP_API_KEY=cambia-esto
# ADMIN_API_KEY está obsoleta: si solo existe ella, se usa como APP_API_KEY (con aviso).
# Hash Argon2id de la contraseña del dueño: genera la línea con `betting-ml hash-password`.
APP_PASSWORD_HASH=
# >= 32 caracteres y distinto de APP_API_KEY (mismo generador que arriba).
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Listas separadas por comas. En prod, ALLOWED_HOSTS sin '*' y CORS_ORIGINS solo con orígenes
# explícitos (vacío si el frontend y la API comparten origen detrás del mismo proxy).
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS_PER_MINUTE=5
ODDS_REFRESH_MAX_PER_HOUR=6
MAX_BODY_BYTES=65536
BACKUP_KEEP=14
# text | json (por defecto: json en prod, text en dev)
LOG_FORMAT=
